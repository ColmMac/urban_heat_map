*.py[cod]
*$py.class
*.egg-info/
dist/
build/

# Testing, Coverage & Linting Caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Geospatial & Data Caches (keep folder structure via .gitkeep)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
cache/
*.tif
*.tiff
*.geotiff
*.parquet
*.geoparquet
*.gpkg
*.shp
*.shx
*.dbf
*.prj
*.cpg

# Jupyter Notebooks (if used for exploratory spatial checks)
.ipynb_checkpoints/

# Secrets & Local Environment Config
.env
.env.*
!.env.example

# IDE & OS Files (Windows 11 / VS Code / Cursor / JetBrains)
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini