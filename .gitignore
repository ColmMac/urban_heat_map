# Python / tooling
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
*.egg-info/

# Raw data cache (ARCHITECTURE §2): ignore everything except the reproducibility anchor
data/raw/*
!data/raw/.gitkeep
!data/raw/lst_scene_manifest.json
data/raw/.osmnx_cache/

# Generated geospatial caches
*.parquet
*.tif

# Allow lightweight web GeoParquet layers for Streamlit Cloud
!data/processed/web/*.parquet
